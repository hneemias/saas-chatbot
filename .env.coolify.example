# ==============================================================================
# VARIÁVEIS UNIFICADAS PARA DEPLOY NO COOLIFY (DOCKER COMPOSE)
# Cole estas variáveis na aba "Environment Variables" (Developer View) do Coolify.
# Redis e comunicação interna (admin-panel -> http://backend:3000) já são automáticos!
# ==============================================================================

# 1. Supabase (Banco de Dados + Storage)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# 2. Segurança do Painel e API Interna
JWT_SECRET=gere_uma_chave_forte_com_pelo_menos_32_caracteres
ADMIN_API_KEY=gere_uma_chave_interna_opcional_para_proteger_rotas_api

# 3. URL Pública do Webhook do Backend (domínio configurado para o serviço `backend` no Coolify)
BACKEND_PUBLIC_WEBHOOK_URL=https://api.seudominio.com/webhook/evolution

# 4. Evolution API (WhatsApp)
EVOLUTION_API_URL=https://api.evolution.seudominio.com
EVOLUTION_API_KEY=sua_master_key_evolution_aqui

# 5. Google Gemini (IA + Failover + Vetores)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536

# 6. Síntese de Voz p/ Equipe Interna (Opcional)
MULTIVOZES_API_URL=
MULTIVOZES_API_KEY=
