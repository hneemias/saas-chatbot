{
  "name": "saas-advocacia-service",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "Backend de atendimento inteligente multitenant para escritórios de advocacia via WhatsApp (Evolution API)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:install": "cd admin-panel && npm install",
    "admin:dev": "cd admin-panel && npm run dev",
    "admin:build": "cd admin-panel && npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^190.0.0",
    "ioredis": "^5.6.0",
    "msedge-tts": "^2.1.1",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
