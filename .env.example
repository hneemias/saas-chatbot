# Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://api.evolution.seudominio.com
EVOLUTION_API_KEY=sua_master_key_aqui

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Redis (Debounce / Filas — possui fallback automático em memória se offline)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Google Gemini (IA + Failover Automático + Embeddings Vetoriais)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536

# Segurança da API do Admin Panel (Opcional — se preenchido, exige header x-api-key nas rotas /api/*)
ADMIN_API_KEY=

# Multivozes / TTS (Opcional — respostas em áudio para o Copiloto da Equipe)
MULTIVOZES_API_URL=https://tts.seudominio.com/v1/audio/speech
MULTIVOZES_API_KEY=sua_chave_multivozes_aqui
